FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl
COPY package*.json ./
COPY apps/api/package*.json apps/api/
COPY apps/web/package*.json apps/web/
COPY prisma ./prisma
RUN npm install
COPY apps/api ./apps/api
RUN npx prisma generate && npm --prefix apps/api run build

FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/prisma ./prisma
ENV NODE_ENV=production
EXPOSE 4000
# Applies migrations if a prisma/migrations folder exists, otherwise syncs the schema, then starts.
CMD ["sh","-c","if [ -d prisma/migrations ]; then npx prisma migrate deploy; else npx prisma db push --skip-generate; fi && node apps/api/dist/server.js"]
